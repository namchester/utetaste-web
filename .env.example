# Public template only. Run scripts/init-env.py on a fresh clone.
# Never copy a configured .env back into this file.
DB_USER=utetaste
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/utetaste
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
OTP_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_BASE_URL=http://localhost:8080
PORT=8080
COOKIE_SECURE=false
SEED_DEMO=true
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD_AT_LEAST_10_CHARACTERS
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_10_CHARACTERS

# Optional Cloudinary. Empty values keep local bundled images available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email OTP. Fill locally before enabling real SMTP.
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
